"""
Problem 13: Find the square root of a number using binary search.
"""

def integer_square_root(x):
    if x < 2:
        return x
    left, right = 1, x
    while left <= right:
        mid = (left + right) // 2
        if mid * mid == x:
            return mid
        elif mid * mid < x:
            left = mid + 1
            ans = mid
        else:
            right = mid - 1
    return ans

