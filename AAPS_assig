"""
Problem 10: Generate all permutations of a given string.
"""

def permute_string(s):
    result = []
    def backtrack(path, used):
        if len(path) == len(s):
            result.append("".join(path))
            return
        for i in range(len(s)):
            if used[i]:
                continue
            used[i] = True
            path.append(s[i])
            backtrack(path, used)
            path.pop()
            used[i] = False
    backtrack([], [False] * len(s))
    return result

# Time Complexity: O(n!)
# Space Complexity: O(n!)

"""
Problem 11: Merge two sorted linked lists into one sorted list.
"""

class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next

def merge_two_lists(l1, l2):
    dummy = ListNode()
    tail = dummy
    while l1 and l2:
        if l1.val < l2.val:
            tail.next = l1
            l1 = l1.next
        else:
            tail.next = l2
            l2 = l2.next
        tail = tail.next
    tail.next = l1 or l2
    return dummy.next

# Time Complexity: O(n + m)
# Space Complexity: O(1)

